{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "preserveSymlinks": true,
    "paths": {
      "@angular/*": ["node_modules/@angular/*"],
      "primeng/*": ["node_modules/primeng/*"]
    }
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
